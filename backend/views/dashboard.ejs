<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=title%></title>
    <%- include('partials/head.ejs') %>
</head>
<body>
     <%- include('partials/header.ejs') %> <!--inyeccion de parcial conheader completo-->
    <body>
    
    
    <main class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="header-texto-secundario fs-3">Listado de Productos</h2>
                
        </div>

        <div class="row mb-4 g-3">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-dark text-white border-secondary">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="buscador-input" class="form-control" placeholder="Buscar por nombre de producto...">
                </div>
        </div>
    
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-dark text-white border-secondary">
                        <i class="bi bi-funnel-fill"></i>
                    </span>
                    <select id="filtro-categoria" class="form-select">
                        <option value="">Todas las Categorías</option>
                        <option value="Comic">Cómics</option>
                        <option value="Figura">Figuras</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-custom align-middle table-hover">
                <thead>
                    <tr>
                        <th scope="col" class="text-center"># ID</th>
                        <th scope="col" class="text-center">IMG</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Categoría</th>
                        <th scope="col">Precio</th>
                        <th scope="col" class="text-center">Stock</th>
                        <th scope="col" class="text-center">Estado</th>
                        <th scope="col" class="text-center">Acciones</th>        
                    </tr>
                </thead>
                <tbody>
                    <% if (productos.length > 0) { %>
                        <% productos.forEach(producto => { %>
                            <tr>

                                <td class="text-center fw-bold"><%= producto.id %></td>
                                
                                <td class="text-center">
                                <img src="/admin/producto/imagen/<%= producto.id %>" alt="<%= producto.nombre %>"
                                         class="rounded border" 
                                         style="width: 50px; height: 50px; object-fit: cover;">
                                </td>
                                <td class="fw-bold"><%= producto.nombre %></td>
                                <td class="text-center"><span class="badge bg-secondary"><%= producto.categoria %></span></td>
                                <td class="text-success fw-bold">$<%= producto.precio %></td>
                                <td class="text-center"><%= producto.stock %></td>
                                <td class="text-center"><%=producto.activo %></td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <form action="/admin/productos/modificar/<%= producto.id %>" method="GET">
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Modificar">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                        </form>
                                        
                                        <form action="/admin/productos/activar-desactivar/<%= producto.id %>" method="POST">
                                            <button type="submit" class="btn btn-sm <%= producto.activo ? 'btn-outline-warning' : 'btn-outline-secondary' %>" title="<%= producto.activo ? 'Desactivar' : 'Activar' %>">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </form>

                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmarEliminacion('<%= producto.id %>')" title="Eliminar">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %> 
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-4">No hay productos cargados en el sistema.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <!-- modal para confirmar la eliminación de un producto -->

    <div id="modalEliminar"class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <h3>¿Estás seguro de que querés eliminar este Producto?</h3>
            <p>Esta accion eliminará el producto permanentemente de la base de datos.</p>

            <div class="modal-actions">
                <button class="btn-cancelar" onclick="cerrarModal()">Cancelar</button>

                <form id="formEliminar" action="" method="post" style="display: inline;">
                    <button class="btn-confirmar" type="submit">Eliminar</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Dejamos acá la función para confirmar la eliminación -->
    <script>
        function confirmarEliminacion(id){
            const modal = document.getElementById('modalEliminar');
            const form = document.getElementById('formEliminar');

            //Actualizamos la acción del formulario con el id correcto
            form.action = '/admin/productos/eliminar/' + id;

            //mostramos el modal
            modal.style.display = 'flex';
        }

        function cerrarModal(){
            document.getElementById('modalEliminar').style.display = 'none';
        }

        //cerrar si se hace click fuera del modal
        window.onclick = function(event){
            const modal = document.getElementById('modalEliminar');
            if(event.target == modal){
                cerrarModal();
            }
        }
    </script>
    <script src="/admin/js/filtroDashboard.js"></script>
    <script src="/admin/js/theme.js"></script>
    <%- include('partials/footer.ejs') %> <!--Inyeccion del partial con el footer-->
</body>
</html>