<div id="card-test" class="card-secreta" data-email="<%= emailTester %>" data-password="<%= passwordTester %>">
    <div class="titulo-card-test">
        <h3 class="m-0">¡Modo tester activado!</h3>
    </div>
    <div class="body-card-test text-center">
        <p><strong>Credenciales de acceso:</strong></p>
        
        <form action="/admin/login" method="POST">
            <div class="form-group px-4">
                <input type="email" id="email-tester" name="email" class="form-control form-control-sm" value="<%= emailTester %>" readonly>
            </div>
            <div class="form-group mb-3 mt-2 px-4"> <input type="password" name="password" class="form-control form-control-sm" value="<%= passwordTester %>" readonly>
            </div>
            
            <div class="text-center">
                <button type="submit" id="btn-continuar-tester" class="btn btn-primary btn-sm w-50">Continuar</button>
            </div>
        </form>

        <hr>
        
        <div class="text-center">
            <button onclick="cerrarCardTest()" id="btn-continuar-tester" class="btn btn-danger btn-sm mb-1">Cerrar</button>
        </div>
    </div>