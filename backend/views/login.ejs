<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <%- include('partials/head.ejs') %>
</head>
<body>
    <header>
        <div class="div-header d-flex align-items-center justify-content-center mx-auto">
            <img src="/admin/img/logo_dark_admin.svg" alt="Logo Los Vigilantes" height="100" class="d-block me-3 logo-responsive">
            <div class="d-flex flex-column text-center">
                <h1 class="header-texto-main m-0">Los Vigilantes</h1>
                <span class="header-texto-secundario">¡Bienvenido al sector gestión!</span>
            </div>
        </div>
        <div class="d-flex gap-3 position-absolute top-0 end-0 m-3 z-1 align-items-center">
             <button id="theme-toggle" class="btn" aria-label="Cambiar Modo oscuro">
                <i class="bi bi-moon-stars-fill fs-5"></i>
            </button>
            <form action="/admin/logout" method="POST" class="m-0">
                    <a class="nav-link" href="/"><i class="bi bi-box-arrow-right"></i>Volver a la tienda</a>
            </form>
        </div>
    </header>
    <main id="main-index" class=" d-flex min-w-100z justify-content-center align-items-center">
        <div id="card-login" class="card-logeo-admin p-4 shadow-lg">
            <div class="card-body d-flex flex-column align-items-center">
                <i class="icono-login abi bi-person-circle"></i>
                <h3 class="card-title mb-4 text-center">Administrador</h3>
                <form action="/admin/login" method="POST">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="email" required>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Contraseña</label>
                        <input type="password" class="form-control" id="password" name="password" required>
                    </div>
                    <div class="d-grid">
                        <button id="btn-login" type="submit" class="btn btn-sm">Ingresar</button>
                    </div>
                </form>
            </div>
        </div>
        <%- include('partials/cardTest.ejs') %> <!--partial con la card para el tester-->
    </main>
    <script src="/admin/js/theme.js"></script>
    <%- include('partials/footer.ejs') %> <!--Inyeccion del partial con el footer-->
    <script src="/admin/js/cardTest.js"></script> <!--inyeccion del script para el acceso al tester-->
</body>
</html>