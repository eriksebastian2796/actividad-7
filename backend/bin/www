// @ts-nocheck
import app from '../app.js';
import { sequelize } from '../config/database.js';
import Usuario from '../models/user.js';
import Producto from '../models/producto.js';
import debug from 'debug';
import http from 'http';
import bcrypt from 'bcryptjs';
import "dotenv/config.js";

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '8000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

const startServer = async () => {
  try {
    await sequelize.sync({ alter: true });
    console.log('Base de datos sincronizada correctamente');

    try {
        const adminEmail = 'admin@admin.com';
        const adminPassword = '1234';
        const testerEmail = 'Tester@Test.com'
        const testerPassword = 'test123';
    
        // Encriptamos la contraseña
        const hashedPassword = await bcrypt.hash(adminPassword, 10); 
        const hashedTesterPassword = await bcrypt.hash(testerPassword, 10); 
    
        // Buscamos o creamos el admin y tester
        const [usuario, creado] = await Usuario.findOrCreate({
            where: { email: adminEmail },
            defaults: {
                email: adminEmail,
                password: hashedPassword,
                role: 'admin'
            }
        });

        const [testerUser, testerCreado] = await Usuario.findOrCreate({
              where: { email: testerEmail },
              defaults: {
                  email: testerEmail,
                  password: hashedTesterPassword, 
                  role: 'tester'
          }
      });
    
        if (creado && testerCreado) {
            console.log('Usuario admin de prueba creado:', usuario.email);
            console.log('Usuario tester creado:', testerUser.email);
        } else {
            console.log('Usuario admin de prueba ya existe:', usuario.email);
            console.log('Usuario tester de prueba ya existe:', testerUser.email);
        }
    
    } catch (error) {
        console.error('Error al crear usuarios de prueba:', error);
    }

    server.listen(port);
    server.on('error',onError);
    server.on('listening',onListening);
  } catch (error){
    console.log('Error al sincronizar la base de datos:', error);
    process.exit(1) //salimos del proceso
  }
}


/**
 * @param {string} val
 * Normalize a port into a number, string, or false.
 */


function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * @param {NodeJS.ErrnoException} error
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();

  //verificación
  if(addr === null) {
    console.error("La dirección del servidor es nula");
    return;
  }
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  console.log('Listening on ' + bind);
}


startServer();